#!/usr/bin/env python3
"""Apply host retention with explicit additional image protection."""
import datetime as dt
import fcntl
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys


UTC = dt.timezone.utc
IMAGE_ID = re.compile(r"sha256:[0-9a-f]{64}")
DIGEST = re.compile(r"[^\s@]+@sha256:[0-9a-f]{64}")
TIMESTAMP = re.compile(
    r"([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2})"
    r"(?:\.([0-9]{1,9}))?(Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])"
)


def timestamp(value):
    if not isinstance(value, str):
        raise ValueError("timestamp must be a string with a timezone")
    parts = TIMESTAMP.fullmatch(value)
    if parts is None:
        raise ValueError("timestamp must use YYYY-MM-DDTHH:MM:SS, optional 1-9 fractional digits, and Z or a ±HH:MM timezone")
    seconds, fraction, timezone = parts.groups()
    # Docker reports nanoseconds; datetime stores microseconds. Truncate, never round.
    fraction = "." + fraction[:6].ljust(6, "0") if fraction else ""
    timezone = "+00:00" if timezone == "Z" else timezone
    return dt.datetime.fromisoformat(seconds + fraction + timezone)


def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f"duplicate JSON setting '{key}'")
        result[key] = value
    return result


def docker(target, *args, capture=True):
    command = ["docker", "--host", "unix://" + target["socket"], *args]
    result = subprocess.run(command, text=True, stdout=subprocess.PIPE if capture else None,
                            timeout=120, check=False)
    if result.returncode:
        raise RuntimeError(f"Docker command failed ({result.returncode}): {' '.join(args)}")
    return result.stdout


def inspect(target, kind, reference):
    rows = json.loads(docker(target, kind, "inspect", reference))
    if not isinstance(rows, list) or len(rows) != 1 or not isinstance(rows[0], dict):
        raise ValueError(f"cannot resolve one {kind} object for {reference}")
    return rows[0]


def image_id(value):
    if not isinstance(value, str) or not IMAGE_ID.fullmatch(value):
        raise ValueError(f"invalid local image ID: {value!r}")
    return value


def container_images(target):
    protected = set()
    for container in docker(target, "container", "ls", "-aq", "--no-trunc").splitlines():
        reference = image_id(inspect(target, "container", container)["Image"])
        protected.add(reference)
    return protected


def trusted_file(descriptor, description):
    metadata = os.fstat(descriptor)
    if not stat.S_ISREG(metadata.st_mode):
        raise ValueError(f"{description} must be a regular file")
    if metadata.st_uid != os.geteuid() or metadata.st_mode & 0o022:
        raise ValueError(f"{description} must be owned by the cleanup account and not writable by group or others")


def read_inventory(path):
    descriptor = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
    with os.fdopen(descriptor, "rb") as stream:
        trusted_file(stream.fileno(), f"protection inventory {path}")
        raw = stream.read(1024 * 1024 + 1)
    if len(raw) > 1024 * 1024:
        raise ValueError("protection inventory exceeds 1 MiB")
    return raw


def load_protection(target, path, daemon_id):
    raw = read_inventory(path)
    inventory = json.loads(raw, object_pairs_hook=unique_object)
    if set(inventory) != {"version", "daemon_id", "expires_at", "deployments", "recovery"}:
        raise ValueError("protection inventory requires version, daemon_id, expires_at, deployments and recovery")
    if type(inventory["version"]) is not int or inventory["version"] != 1:
        raise ValueError("unsupported protection inventory version; expected 1")
    if inventory["daemon_id"] != daemon_id:
        raise ValueError("protection inventory belongs to a different Docker daemon")
    expiry = timestamp(inventory["expires_at"])
    if expiry <= dt.datetime.now(UTC):
        raise ValueError("protection inventory has expired; deployment must reconcile and renew it")
    deployments = inventory["deployments"]
    if not isinstance(deployments, dict) or not deployments:
        raise ValueError("protection inventory must name every deployment; empty inventory is rejected")
    references = inventory["recovery"]
    if not isinstance(references, list):
        raise ValueError("recovery must be a list of locally retained repository digests")
    references = list(references)
    for name, deployment in deployments.items():
        if not name or not isinstance(deployment, dict) or set(deployment) != {"current", "rollback"}:
            raise ValueError(f"deployment {name!r} requires current and rollback digest lists")
        for role in ("current", "rollback"):
            values = deployment[role]
            if not isinstance(values, list) or (role == "current" and not values):
                raise ValueError(f"deployment {name!r} {role} must be a digest list; current cannot be empty")
            references.extend(values)
    protected = set()
    for reference in references:
        if not isinstance(reference, str) or not DIGEST.fullmatch(reference):
            raise ValueError(f"protection requires an immutable repository digest: {reference!r}")
        row = inspect(target, "image", reference)
        if reference not in (row.get("RepoDigests") or []):
            raise ValueError(f"protected digest {reference} does not resolve consistently")
        protected.add(image_id(row["Id"]))
    return raw, expiry, protected


def available_bytes(root):
    usage = os.statvfs(root)
    return usage.f_bavail * usage.f_frsize


def assert_inventory_current(path, raw, expiry):
    if read_inventory(path) != raw or dt.datetime.now(UTC) >= expiry:
        raise ValueError("protection inventory changed or expired during cleanup; stopping further deletion")


class ImageProtection:
    def __init__(self, target):
        self.target = target
        self.mode = target['image_protection_mode']
        self.path = Path(target['image_protection_file'])
        self.tags = target['image_keep_tags']

    def load(self, daemon_id):
        if self.mode == "inventory":
            self.raw, self.expiry, self.inventory_ids = load_protection(self.target, self.path, daemon_id)
        return self.refresh()

    def refresh(self):
        if self.mode == "inventory":
            assert_inventory_current(self.path, self.raw, self.expiry)
            return self.inventory_ids
        protected = set()
        for reference in self.tags:
            try:
                row = inspect(self.target, "image", reference)
            except RuntimeError as error:
                raise ValueError(f"Cannot protect selected local tag {reference!r}: {error}") from error
            tags = row.get("RepoTags")
            if not isinstance(tags, list) or any(not isinstance(tag, str) for tag in tags):
                raise ValueError(f"Cannot protect selected local tag {reference!r}: Docker RepoTags must be a list of tag strings")
            if reference not in tags:
                raise ValueError(f"Selected local tag {reference!r} is absent from its resolved image's RepoTags; stopping cleanup")
            protected.add(image_id(row["Id"]))
        return protected


def retain_images(target, protection, container_ids, root, minimum_free, cutoff):
    candidates = []
    for reference in set(docker(target, "image", "ls", "-aq", "--no-trunc").splitlines()):
        reference = image_id(reference)
        row = inspect(target, "image", reference)
        if image_id(row["Id"]) != reference:
            raise ValueError(f"image {reference} does not resolve consistently")
        candidates.append((timestamp(row["Created"]), reference))
    failures = False
    for created, reference in sorted(candidates):
        container_ids.update(container_images(target))
        protected = protection.refresh()
        if reference in protected or reference in container_ids:
            print(f"Retain protected image {reference}", flush=True)
            continue
        if created > cutoff and available_bytes(root) >= minimum_free:
            continue
        container_ids.update(container_images(target))
        protected = protection.refresh()
        if reference in protected or reference in container_ids:
            print(f"Retain protected image {reference}", flush=True)
            continue
        print(f"Remove unprotected image {reference} (created {created.isoformat()})", flush=True)
        try:
            # No parent pruning: an untagged parent can itself be protected.
            docker(target, "image", "rm", "--no-prune", reference, capture=False)
        except RuntimeError as error:
            print(error, file=sys.stderr)
            failures = True
    free = available_bytes(root)
    print(f"Docker filesystem available bytes: {free}; required: {minimum_free}", flush=True)
    if free < minimum_free:
        raise RuntimeError("Cannot meet the Docker filesystem free-space target with removable unprotected images; retained images and other data still occupy space")
    return failures


def main():
    import argparse
    import pwd
    from auto_cleanup_config import load_target, verify_socket_owner

    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--config', required=True)
    parser.add_argument('--show-policy', action='store_true')
    arguments = parser.parse_args()
    target = load_target(arguments.config, trusted=not arguments.show_policy)
    if arguments.show_policy:
        print(json.dumps(target, indent=2, sort_keys=True))
        return 0
    if pwd.getpwnam(target['user']).pw_uid != os.geteuid():
        raise ValueError(f"cleanup for {target['name']} must run as {target['user']}")
    verify_socket_owner(target, os.geteuid())
    return run_cleanup(target)


def run_cleanup(target):
    """Apply a validated target; the CLI owns account and configuration admission."""
    endpoint = 'unix://' + target['socket']
    cutoff = dt.datetime.now(UTC) - dt.timedelta(hours=int(target['image_until'][:-1]))
    protection = ImageProtection(target)
    for key in ("DOCKER_CONTEXT", "DOCKER_HOST", "DOCKER_TLS", "DOCKER_TLS_VERIFY", "DOCKER_CERT_PATH"):
        os.environ.pop(key, None)
    try:
        info = json.loads(docker(target, "info", "--format", "{{json .}}"))
    except RuntimeError as error:
        raise RuntimeError(f"Docker daemon at {endpoint} is not reachable: {error}") from error
    if not isinstance(info, dict) or not isinstance(info.get("ID"), str) or not info["ID"]:
        raise ValueError("Docker did not report its daemon identity")
    security = info.get('SecurityOptions')
    if not isinstance(security, list) or any(not isinstance(option, str) for option in security):
        raise ValueError('Docker did not report valid SecurityOptions for the configured target')
    rootless = 'name=rootless' in security
    if rootless != (target['kind'] == 'rootless'):
        raise ValueError(f"Docker at {endpoint} does not match configured kind {target['kind']}")
    root = info.get('DockerRootDir')
    if not isinstance(root, str) or not root.startswith('/'):
        raise ValueError('Docker did not report an absolute storage directory')
    available_bytes(root)
    # Publishers must hold this same stable lock through publication and deployment.
    descriptor = os.open(str(protection.path) + ".lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(descriptor, "r+") as lock:
        trusted_file(lock.fileno(), f"protection lock {protection.path}.lock")
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise RuntimeError(f"Protection lock {protection.path}.lock is busy; deployment or another cleanup is in progress") from error
        protection.load(info["ID"])
        container_ids = container_images(target)
        failures = False
        prunes = [("container", "prune", "-f", "--filter", f"until={target['container_until']}", "--filter", "label=auto-cleanup.disposable=true")]
        if target['network_until'] is not None:
            prunes.append(("network", "prune", "-f", "--filter", f"until={target['network_until']}"))
        else:
            print('Network cleanup disabled by policy.', flush=True)
        for args in prunes:
            try:
                protection.refresh()
                docker(target, *args, capture=False)
            except RuntimeError as error:
                print(error, file=sys.stderr)
                failures = True
        failures |= retain_images(target, protection, container_ids, root, target['image_min_free_gib'] * 1024**3, cutoff)
        if failures:
            raise RuntimeError("One or more Docker cleanup commands failed.")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, KeyError, TypeError, OverflowError, subprocess.TimeoutExpired, RuntimeError) as error:
        print(f"Cannot complete Docker cleanup: {error}. Cleanup may be partial if removal has started.", file=sys.stderr)
        sys.exit(1)
