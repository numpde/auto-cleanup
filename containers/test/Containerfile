# syntax=docker/dockerfile:1.7

ARG BASE_IMAGE=docker.io/library/debian:12-slim@sha256:60eac759739651111db372c07be67863818726f754804b8707c90979bda511df
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        bash \
        coreutils \
        dash \
        findutils \
        gawk \
        grep \
        logrotate \
        passwd \
        python3 \
        sed \
        systemd \
        util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 65532 test-runner \
    && useradd --uid 65532 --gid 65532 --no-create-home --no-log-init \
        --shell /usr/sbin/nologin test-runner

WORKDIR /work
COPY . /work
# Runtime fixtures exercise the same root-owned configuration boundary as /etc.
RUN chmod 0755 /work /work/tests /work/tests/fixtures
RUN chmod 0644 /work/tests/fixtures/target-rootful.json /work/tests/fixtures/target-rootless.json

CMD ["/bin/sh"]
